# Local Windows GPU runtime. Remote deployment settings are optional for local use.
IRODORI_DEPLOY_DIR=C:\path\to\irodori-tts-infra
# IRODORI_REMOTE_HOST=user@hostname
IRODORI_TTS_SERVER_HOST=127.0.0.1
IRODORI_TTS_SERVER_PORT=8924

# Windows-side paths (used by deploy scripts)
IRODORI_TTS_DIR=C:\path\to\Irodori-TTS
IRODORI_TTS_RUNTIME_PYTHON=3.11
IRODORI_TTS_TORCH_BACKEND_EXTRA=cu128
IRODORI_TTS_RUNTIME_CHECKPOINT=Aratako/Irodori-TTS-v4.1-Small
IRODORI_TTS_RUNTIME_CHECKPOINT_REVISION=2b28324dc263ed5e6638b3cf3dd94c82ead07b4b
IRODORI_TTS_RUNTIME_CHECKPOINT_SHA256=c85de88c01700cb53538e706f128ebcb1b8513ad21d7d0e75f58bc82cdbf89f6
IRODORI_TTS_RUNTIME_CHECKPOINT_TOKENIZER_JSON_SHA256=6a0734cf21c802169defaffe719bc2ef12bb9d0be37e54b61ed27aa89394723d
IRODORI_TTS_RUNTIME_CHECKPOINT_TOKENIZER_CONFIG_SHA256=d229a271c64de1a7939d20d3665498e873fa91d5ee2edf135d73ec752cb9c9d3
IRODORI_TTS_RUNTIME_CFG_SCALE_CAPTION=3.0
IRODORI_TTS_RUNTIME_WARMUP_STYLE=calm
# Opaque identifier for the active runtime and voice-bank pair. Change it whenever
# either member changes; do not expose checkpoint or asset metadata through it.
IRODORI_TTS_RUNTIME_PUBLIC_GENERATION=unconfigured

# Voice bank data
VOICE_BANK_DIR=./data/voice_banks
# Optional explicit manifest override. Leave unset when VOICE_BANK_DIR is set.
# VOICE_BANK_SPEAKER_MANIFEST=./data/voice_banks/voice_bank_speakers.toml
# Each manifest entry may define voice_id, label, aliases, and default. Aliases
# must remain globally unambiguous; startup fails closed on collisions.
# Windows runtime example:
# VOICE_BANK_DIR=C:\Users\takut\Dev\Irodori-TTS

# Cache
CACHE_DIR=./data/cache
CACHE_MAX_SIZE_GB=20
